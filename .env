# ===== WAJIB =====
# Password login menu Admin di web
ADMIN_PASSWORD=ganti-ini
# String acak panjang (minimal 32 karakter). Dipakai menandatangani cookie admin
# dan mengenkripsi data OTP sementara. Bikin: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ===== DATABASE (file lokal, tanpa layanan luar) =====
# Kosongkan saja. Default: ./data/db.json (di Vercel otomatis /tmp/vincent-pay.json).
# Kalau mau lokasi lain (misal volume panel): DB_PATH=/home/container/data/db.json
DB_PATH=

# ===== OPSIONAL =====
# Token dan QRIS bisa diisi lewat menu Admin, env di bawah cuma cadangan kalau database kosong
GOPAY_ACCESS_TOKEN=
GOPAY_REFRESH_TOKEN=
GOPAY_QRIS=
SHOPEE_TOKEN=
SHOPEE_QRIS=

# Pengaman endpoint /api/cron/refresh (dipakai Vercel Cron untuk perpanjang token tiap hari)
CRON_SECRET=

# Kalau OTP GoMerch gagal karena GoBiz pindah host/versi login, isi ini (kosong = bawaan lama)
GOBIZ_AUTH_URL=
GOBIZ_APP_VERSION=

# Kalau OTP ShopeePay tidak pernah sampai: isi dengan "device report" dari browsermu sendiri
# (lihat README bagian ShopeePay). Kosong = dicoba tanpa itu.
SHOPEE_DEVICE_REPORT=
