# Vincent Pay - server runtime
PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000

# Set all of these before a production deployment
JWT_SECRET=replace-with-at-least-32-random-characters
MASTER_ENCRYPTION_KEY=replace-with-a-different-random-secret-minimum-32-chars
ADMIN_EMAIL=kontol@gmail.com
ADMIN_USERNAME=vincentadmin
ADMIN_PASSWORD=#FFHUDT6O3jiQiSWxPo7eO

# Local server can use SQLite. Vercel must use persistent PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/vincentpay
PGSSL=require
PG_POOL_MAX=10
DATA_DIR=./data

# Optional: comma-separated exact origins for external API clients
CORS_ORIGIN=
TRUST_PROXY=false
PROVIDER_TIMEOUT_MS=12000

# Optional email delivery for password recovery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vincent Pay <no-reply@example.com>

# Provider callback URLs after deployment:
# DANA: https://your-domain/api/provider-webhooks/dana
# ShopeePay: https://your-domain/api/provider-webhooks/shopeepay
# GoBiz: https://your-domain/api/provider-webhooks/gopay
