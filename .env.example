# TIDAK ADA ENV WAJIB. Deploy langsung jalan, semua menu terbuka (mode publik).
# Semua di bawah ini opsional.

# ---------- keamanan ----------
# Mau dikunci? Isi password ini (min. 12 karakter), menu admin jadi minta login.
ADMIN_PASSWORD=
# Kunci enkripsi challenge OTP + tanda tangan cookie admin.
# Kosong = dibuat acak & disimpan di backend penyimpanan (Redis/file).
SESSION_SECRET=
# Kunci khusus bot. Kalau diisi, bot bisa pakai route /api/bot/pay/* dengan header x-api-key.
# HARUS berbeda dari ADMIN_PASSWORD.
BOT_API_KEY=
# Secret untuk /api/cron/refresh (fail-closed kalau kosong).
CRON_SECRET=

# ---------- penyimpanan (Vercel: isi Redis supaya state bertahan) ----------
# Upstash Redis REST (atau Vercel KV: KV_REST_API_URL / KV_REST_API_TOKEN)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Lokasi file kv (VPS/lokal). Kosong = ./data/kv.json
KV_PATH=
# Lokasi file database lama (kompatibilitas). Kosong = ./data/db.json
DB_PATH=

# ---------- identitas perangkat Shopee ----------
# Device id stabil (kosong = diturunkan dari seed, tetap sama antar restart)
SHOPEE_DEVICE_ID=
# Blob telemetri asli dari browser (DevTools > Network > /v2/shpsec/web/report > Payload)
SHOPEE_DEVICE_REPORT=
# Header szdet asli dari browser (request yang sama > Headers > szdet)
SHOPEE_SZDET=
# captcha_signature dari request send_otp yang sukses di browser
SHOPEE_CAPTCHA_SIGNATURE=
# Skema hash password Shopee: md5sha256 (default) | sha256 | plain
SHOPEE_PW_HASH=
# User-Agent untuk semua panggilan Shopee
SHOPEE_UA=

# ---------- lain-lain ----------
# Cadangan kalau database kosong (normalnya cukup diisi lewat dashboard)
GOPAY_ACCESS_TOKEN=
GOPAY_REFRESH_TOKEN=
GOPAY_QRIS=
SHOPEE_TOKEN=
SHOPEE_QRIS=

# Isi 0 untuk mematikan loop auto refresh di server (default: nyala di VPS/panel, tidak ada di Vercel)
AUTO_LOOP=

# Kalau OTP GoMerch gagal karena GoBiz pindah host/versi login
GOBIZ_AUTH_URL=
GOBIZ_APP_VERSION=
