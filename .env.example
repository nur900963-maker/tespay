# TIDAK ADA ENV WAJIB. Deploy langsung jalan, semua menu terbuka (mode publik).
# Semua di bawah ini opsional.

# Mau dikunci? Isi password ini, menu admin (login OTP, QRIS, riwayat) jadi minta login.
ADMIN_PASSWORD=

# Lokasi file database. Kosong = ./data/db.json (di Vercel otomatis /tmp/vincent-pay.json)
DB_PATH=

# Kunci khusus bot. Kalau diisi, bot bisa pakai route /api/bot/pay/* dengan header x-api-key.
BOT_API_KEY=

# Cadangan kalau database kosong (normalnya cukup diisi lewat dashboard)
GOPAY_ACCESS_TOKEN=
GOPAY_REFRESH_TOKEN=
GOPAY_QRIS=
SHOPEE_TOKEN=
SHOPEE_QRIS=

# Isi 0 untuk mematikan loop auto refresh di server (default: nyala di VPS/panel, tidak ada di Vercel)
AUTO_LOOP=

# Kalau OTP GoMerch gagal karena GoBiz pindah host/versi login
GOBIZ_AUTH_URL=
GOBIZ_APP_VERSION=

# Kalau OTP ShopeePay tidak pernah sampai (lihat README)
SHOPEE_DEVICE_REPORT=
