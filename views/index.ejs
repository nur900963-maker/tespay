<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0a1f1c">
<title>Vincent Pay — Dashboard QRIS</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* ============================================================
   Vincent Pay — design tokens
   Palet: deep teal + coral (BUKAN indigo/violet seperti referensi)
   ============================================================ */
:root{
  --ink:#0a1f1c;
  --ink-2:#123a34;
  --brand:#0f766e;
  --brand-2:#14b8a6;
  --brand-soft:#e6f4f1;
  --accent:#ff7a45;
  --accent-soft:#fff0e9;
  --bg:#f5f4ef;
  --card:#ffffff;
  --line:#e4e2d9;
  --line-2:#efeee7;
  --muted:#6d7b77;
  --muted-2:#93a09c;
  --ok:#0f9d58;
  --warn:#d97706;
  --err:#dc2626;
  --r:18px;
  --r-sm:12px;
  --shadow:0 1px 2px rgba(10,31,28,.05), 0 10px 30px -18px rgba(10,31,28,.35);
  --shadow-lg:0 2px 4px rgba(10,31,28,.05), 0 24px 60px -28px rgba(10,31,28,.45);
  --mono:'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
  --sans:'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0; background:var(--bg); color:var(--ink);
  font-family:var(--sans); font-size:14px; line-height:1.55;
  -webkit-font-smoothing:antialiased;
  background-image:radial-gradient(circle at 12% -10%, #e9f3f0 0%, transparent 45%),
                   radial-gradient(circle at 92% 4%, #fdf0e9 0%, transparent 38%);
  background-repeat:no-repeat;
}
h1,h2,h3,h4,p{margin:0}
button{font-family:inherit; cursor:pointer}
input,select,textarea{font-family:inherit; font-size:14px}
a{color:var(--brand); text-decoration:none}
::selection{background:#bff0e6; color:var(--ink)}

/* ---------- topbar ---------- */
.topbar{
  position:fixed; inset:0 0 auto 0; z-index:60; height:62px;
  display:flex; align-items:center;
  background:rgba(255,255,255,.82);
  backdrop-filter:saturate(180%) blur(14px);
  -webkit-backdrop-filter:saturate(180%) blur(14px);
  border-bottom:1px solid var(--line);
}
.topbar-inner{
  width:100%; max-width:880px; margin:0 auto; padding:0 18px;
  display:flex; align-items:center; justify-content:space-between; gap:12px;
}
.brand{display:flex; align-items:center; gap:10px; min-width:0}
.brand-mark{
  width:34px; height:34px; border-radius:11px; flex:0 0 auto;
  background:linear-gradient(145deg, var(--brand-2), var(--brand) 55%, var(--ink));
  display:grid; place-items:center; color:#fff; font-weight:800; font-size:15px;
  box-shadow:0 6px 16px -8px rgba(15,118,110,.9);
  letter-spacing:-.5px;
}
.brand-name{font-size:15px; font-weight:800; letter-spacing:-.3px; white-space:nowrap}
.brand-sub{font-size:10.5px; color:var(--muted-2); font-weight:600; letter-spacing:.06em; text-transform:uppercase; line-height:1}
.topbar-right{display:flex; align-items:center; gap:8px}
.pill{
  display:inline-flex; align-items:center; gap:6px;
  height:28px; padding:0 10px; border-radius:999px;
  font-size:11px; font-weight:700; letter-spacing:.01em;
  background:#fff; border:1px solid var(--line); color:var(--muted);
  white-space:nowrap;
}
.pill .dot{width:6px; height:6px; border-radius:50%; background:var(--muted-2); flex:0 0 auto}
.pill.on{background:var(--brand-soft); border-color:#c9e9e2; color:#0b5d55}
.pill.on .dot{background:var(--ok); box-shadow:0 0 0 3px rgba(15,157,88,.14)}
.pill.off{background:#fdf1f1; border-color:#f6d9d9; color:#a33}
.pill.off .dot{background:var(--err)}
.pill.hide-sm{display:none}
@media(min-width:560px){ .pill.hide-sm{display:inline-flex} }
.icon-btn{
  width:36px; height:36px; border-radius:11px; border:1px solid var(--line);
  background:#fff; color:var(--ink); display:grid; place-items:center;
  transition:.18s ease;
}
.icon-btn:hover{background:var(--brand-soft); border-color:#c9e9e2; color:var(--brand)}
.icon-btn svg{width:17px; height:17px}

/* ---------- layout ---------- */
main{max-width:880px; margin:0 auto; padding:86px 18px 40px}
@media(max-width:520px){ main{padding:78px 14px 32px} }

/* ---------- hero ---------- */
.hero{
  position:relative; overflow:hidden;
  border-radius:24px; padding:34px 26px 26px;
  background:
    radial-gradient(120% 140% at 88% -20%, rgba(20,184,166,.55) 0%, transparent 55%),
    radial-gradient(90% 120% at 0% 110%, rgba(255,122,69,.30) 0%, transparent 55%),
    linear-gradient(160deg, #0c2a26 0%, #0a1f1c 60%, #071614 100%);
  color:#fff; box-shadow:var(--shadow-lg);
  text-align:center;
}
.hero::after{
  content:''; position:absolute; inset:0; pointer-events:none; opacity:.35;
  background-image:linear-gradient(rgba(255,255,255,.05) 1px, transparent 1px),
                   linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px);
  background-size:34px 34px;
  mask-image:radial-gradient(circle at 50% 0%, #000 0%, transparent 72%);
  -webkit-mask-image:radial-gradient(circle at 50% 0%, #000 0%, transparent 72%);
}
.hero > *{position:relative; z-index:1}
.hero-mark{
  width:56px; height:56px; margin:0 auto 14px; border-radius:18px;
  background:linear-gradient(150deg, #2dd4bf, #0f766e 60%, #0a1f1c);
  display:grid; place-items:center; font-weight:800; font-size:22px; letter-spacing:-1px;
  box-shadow:0 14px 34px -14px rgba(45,212,191,.85), inset 0 1px 0 rgba(255,255,255,.35);
}
.hero h1{font-size:clamp(21px,4.6vw,29px); font-weight:800; letter-spacing:-.7px; line-height:1.2}
.hero p.sub{margin-top:8px; font-size:12.5px; color:#a9c6c0; font-weight:500; max-width:430px; margin-left:auto; margin-right:auto}
.accent-line{
  width:56px; height:3px; border-radius:99px; margin:16px auto 0;
  background:linear-gradient(90deg, var(--accent), #ffb08a);
  box-shadow:0 0 18px rgba(255,122,69,.6);
}
.search-wrap{position:relative; max-width:400px; margin:22px auto 0}
.search-wrap svg{
  position:absolute; left:14px; top:50%; transform:translateY(-50%);
  width:16px; height:16px; color:#7f9a95; pointer-events:none;
}
.search-input{
  width:100%; height:44px; padding:0 14px 0 40px;
  border-radius:13px; border:1px solid rgba(255,255,255,.16);
  background:rgba(255,255,255,.09); color:#fff; font-size:13px; font-weight:500;
  outline:none; transition:.2s;
}
.search-input::placeholder{color:#8aa5a0}
.search-input:focus{background:rgba(255,255,255,.14); border-color:rgba(45,212,191,.6); box-shadow:0 0 0 4px rgba(20,184,166,.16)}
.hero-stats{
  display:grid; grid-template-columns:repeat(3,1fr); gap:8px;
  margin-top:22px; padding-top:18px; border-top:1px solid rgba(255,255,255,.10);
}
.hstat{text-align:center; min-width:0}
.hstat .k{font-size:9.5px; letter-spacing:.1em; text-transform:uppercase; color:#7f9a95; font-weight:700}
.hstat .v{font-size:12.5px; font-weight:700; margin-top:3px; color:#e8f5f2; white-space:nowrap; overflow:hidden; text-overflow:ellipsis}
.hstat .v.ok{color:#5eead4}
.hstat .v.bad{color:#ffb4a0}

/* ---------- section ---------- */
.section{margin-top:34px}
.section-head{display:flex; align-items:flex-end; justify-content:space-between; gap:12px; margin-bottom:14px; padding:0 2px}
.section-head .lbl{font-size:10px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; color:var(--brand)}
.section-head h2{font-size:17px; font-weight:800; letter-spacing:-.4px; margin-top:2px}
.section-head .count{
  font-size:11px; font-weight:700; color:var(--muted);
  background:#fff; border:1px solid var(--line); border-radius:999px; padding:3px 9px; white-space:nowrap;
}
.section-desc{font-size:12.5px; color:var(--muted); margin:-6px 2px 14px; max-width:640px}

/* ---------- endpoint card ---------- */
.card{
  background:var(--card); border:1px solid var(--line); border-radius:var(--r);
  box-shadow:var(--shadow); overflow:hidden; margin-bottom:10px;
  transition:border-color .18s, box-shadow .18s, transform .18s;
}
.card:hover{border-color:#d3e7e2; box-shadow:0 2px 4px rgba(10,31,28,.05), 0 18px 40px -26px rgba(10,31,28,.5)}
.card.open{border-color:#bfe3db; box-shadow:0 2px 4px rgba(10,31,28,.05), 0 22px 50px -30px rgba(15,118,110,.6)}
.card-head{
  display:flex; align-items:center; gap:11px; width:100%;
  padding:14px 15px; background:none; border:0; text-align:left; color:inherit;
}
.method{
  flex:0 0 auto; font-family:var(--mono); font-size:9.5px; font-weight:700; letter-spacing:.06em;
  padding:4px 7px; border-radius:7px; border:1px solid transparent;
}
.method.post{background:var(--brand-soft); color:#0b5d55; border-color:#c9e9e2}
.method.get{background:#eef2ff; color:#3b4fa8; border-color:#dbe2fb}
.method.del{background:#fdeeee; color:#a33; border-color:#f6d9d9}
.card-title{min-width:0; flex:1}
.card-title .p{font-family:var(--mono); font-size:12px; font-weight:600; color:var(--ink); letter-spacing:-.2px; overflow-wrap:anywhere}
.card-title .t{font-size:11px; color:var(--muted); margin-top:1px; font-weight:500}
.chev{flex:0 0 auto; width:22px; height:22px; color:var(--muted-2); transition:transform .22s}
.card.open .chev{transform:rotate(180deg); color:var(--brand)}
.card-body{display:none; padding:0 15px 15px; border-top:1px dashed var(--line-2)}
.card.open .card-body{display:block; animation:slide .22s ease}
@keyframes slide{from{opacity:0; transform:translateY(-4px)} to{opacity:1; transform:none}}
.card-desc{font-size:12.5px; color:var(--muted); padding:12px 0 2px; line-height:1.6}
.fields{display:grid; grid-template-columns:1fr 1fr; gap:9px; margin-top:12px}
@media(max-width:560px){ .fields{grid-template-columns:1fr} }
.field{min-width:0}
.field.full{grid-column:1/-1}
.field label{display:block; font-size:10.5px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; color:var(--muted); margin-bottom:5px}
.field label .req{color:var(--accent)}
.field input,.field select{
  width:100%; height:38px; padding:0 11px; border-radius:10px;
  border:1px solid var(--line); background:#fcfcfa; color:var(--ink);
  outline:none; transition:.16s; font-size:13px;
}
.field input:focus,.field select:focus{border-color:var(--brand-2); background:#fff; box-shadow:0 0 0 3px rgba(20,184,166,.13)}
.field input::placeholder{color:#b3bdb9}
.actions{display:flex; flex-wrap:wrap; gap:8px; margin-top:13px; align-items:center}
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:7px;
  height:38px; padding:0 15px; border-radius:11px; border:1px solid transparent;
  font-size:12.5px; font-weight:700; letter-spacing:.01em; transition:.16s;
}
.btn svg{width:14px; height:14px}
.btn-primary{background:linear-gradient(160deg, var(--brand-2), var(--brand)); color:#fff; box-shadow:0 8px 20px -12px rgba(15,118,110,.95)}
.btn-primary:hover{filter:brightness(1.06); transform:translateY(-1px)}
.btn-primary:active{transform:none}
.btn-primary:disabled{opacity:.55; cursor:not-allowed; transform:none; filter:none}
.btn-ghost{background:#fff; border-color:var(--line); color:var(--ink)}
.btn-ghost:hover{background:var(--brand-soft); border-color:#c9e9e2; color:#0b5d55}
.btn-accent{background:var(--accent-soft); border-color:#ffd9c9; color:#b8451c}
.btn-accent:hover{background:#ffe4d8}
.btn-sm{height:32px; padding:0 11px; font-size:11.5px; border-radius:9px}
.spin{width:13px; height:13px; border-radius:50%; border:2px solid rgba(255,255,255,.4); border-top-color:#fff; animation:sp .7s linear infinite}
@keyframes sp{to{transform:rotate(360deg)}}

/* ---------- response ---------- */
.resp{margin-top:12px; display:none}
.resp.show{display:block; animation:slide .2s ease}
.resp-bar{
  display:flex; align-items:center; gap:8px; flex-wrap:wrap;
  font-size:10.5px; font-weight:700; color:var(--muted); margin-bottom:6px;
}
.tag{font-family:var(--mono); font-size:10px; font-weight:700; padding:2px 7px; border-radius:6px}
.tag.s2{background:var(--brand-soft); color:#0b5d55}
.tag.s4{background:#fdf3e6; color:#a35c00}
.tag.s5{background:#fdeeee; color:#a33}
.resp pre{
  margin:0; padding:12px 13px; border-radius:12px; background:#0a1f1c; color:#c9e8e1;
  font-family:var(--mono); font-size:11.5px; line-height:1.6;
  max-height:300px; overflow:auto; white-space:pre-wrap; overflow-wrap:anywhere;
  border:1px solid #123a34;
}
.resp pre::-webkit-scrollbar{width:8px; height:8px}
.resp pre::-webkit-scrollbar-thumb{background:#2a4f48; border-radius:9px}

/* ---------- alert / hint ---------- */
.alert{
  display:flex; gap:10px; padding:11px 12px; border-radius:12px; margin-top:11px;
  font-size:12px; line-height:1.55; border:1px solid;
}
.alert .ico{flex:0 0 auto; width:16px; height:16px; margin-top:1px}
.alert b{display:block; font-size:11.5px; margin-bottom:2px; letter-spacing:.01em}
.alert.err{background:#fdf1f1; border-color:#f6d9d9; color:#8f2b2b}
.alert.warn{background:#fdf7ea; border-color:#f3e2bd; color:#8a5a08}
.alert.ok{background:var(--brand-soft); border-color:#c9e9e2; color:#0b5d55}
.alert code{font-family:var(--mono); font-size:11px; background:rgba(0,0,0,.05); padding:1px 4px; border-radius:4px}

/* ---------- OTP stepper ---------- */
.flow{background:var(--card); border:1px solid var(--line); border-radius:var(--r); box-shadow:var(--shadow); overflow:hidden; margin-bottom:12px}
.flow-head{padding:16px 16px 0}
.flow-head .lbl{font-size:10px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; color:var(--accent)}
.flow-head h3{font-size:15.5px; font-weight:800; letter-spacing:-.3px; margin-top:3px}
.flow-head p{font-size:12px; color:var(--muted); margin-top:5px; line-height:1.6}
.steps{padding:16px}
.step{position:relative; padding-left:38px; padding-bottom:18px}
.step:last-child{padding-bottom:0}
.step::before{
  content:''; position:absolute; left:13px; top:26px; bottom:0; width:2px;
  background:var(--line-2);
}
.step:last-child::before{display:none}
.step.done::before{background:#bfe3db}
.step-num{
  position:absolute; left:0; top:0; width:28px; height:28px; border-radius:50%;
  display:grid; place-items:center; font-size:11.5px; font-weight:800;
  background:#f2f1ea; color:var(--muted-2); border:2px solid var(--bg);
  transition:.2s;
}
.step.active .step-num{background:linear-gradient(160deg,var(--brand-2),var(--brand)); color:#fff; box-shadow:0 0 0 4px rgba(20,184,166,.16)}
.step.done .step-num{background:var(--brand-soft); color:#0b5d55; border-color:#c9e9e2}
.step-title{font-size:12.5px; font-weight:800; letter-spacing:-.1px; padding-top:4px}
.step-title span{font-weight:600; color:var(--muted-2); font-size:11px; margin-left:6px}
.step-body{margin-top:9px}
.step-body .fields{margin-top:0}
.step.locked{opacity:.5; pointer-events:none}

/* trace chips */
.trace{display:flex; flex-wrap:wrap; gap:5px; margin-top:10px}
.chip{
  display:inline-flex; align-items:center; gap:5px;
  font-family:var(--mono); font-size:10px; font-weight:600;
  padding:3px 7px; border-radius:7px; background:#f4f3ec; color:var(--muted);
  border:1px solid var(--line-2);
}
.chip .d{width:5px; height:5px; border-radius:50%; background:var(--muted-2)}
.chip.ok{background:var(--brand-soft); color:#0b5d55; border-color:#c9e9e2}
.chip.ok .d{background:var(--ok)}
.chip.bad{background:#fdeeee; color:#a33; border-color:#f6d9d9}
.chip.bad .d{background:var(--err)}

/* token box */
.tokenbox{
  margin-top:10px; padding:11px 12px; border-radius:12px;
  background:#0a1f1c; border:1px solid #123a34; color:#c9e8e1;
  font-family:var(--mono); font-size:11px; line-height:1.6;
  overflow-wrap:anywhere; max-height:150px; overflow:auto;
}
.tokenbox .k{color:#5eead4; font-weight:700}

/* merchant picker */
.merchants{display:grid; gap:7px; margin-top:10px}
.merchant{
  display:flex; align-items:center; justify-content:space-between; gap:10px;
  padding:10px 12px; border-radius:11px; border:1px solid var(--line);
  background:#fcfcfa; text-align:left; width:100%; transition:.16s;
}
.merchant:hover{border-color:var(--brand-2); background:var(--brand-soft)}
.merchant .n{font-size:12.5px; font-weight:700}
.merchant .i{font-family:var(--mono); font-size:10.5px; color:var(--muted)}

/* ---------- status grid ---------- */
.grid2{display:grid; grid-template-columns:1fr 1fr; gap:10px}
@media(max-width:640px){ .grid2{grid-template-columns:1fr} }
.stat-card{background:var(--card); border:1px solid var(--line); border-radius:var(--r); padding:15px; box-shadow:var(--shadow)}
.stat-card .top{display:flex; align-items:center; justify-content:space-between; gap:8px}
.stat-card .name{font-size:12.5px; font-weight:800; letter-spacing:-.1px}
.stat-card .rows{margin-top:11px; display:grid; gap:6px}
.srow{display:flex; align-items:baseline; justify-content:space-between; gap:10px; font-size:11.5px}
.srow .k{color:var(--muted); font-weight:600}
.srow .v{font-family:var(--mono); font-size:11px; font-weight:600; text-align:right; overflow-wrap:anywhere}
.srow .v.ok{color:#0b7a4b}
.srow .v.bad{color:var(--err)}
.srow .v.warn{color:var(--warn)}
.switch{position:relative; width:38px; height:22px; flex:0 0 auto}
.switch input{position:absolute; opacity:0; width:100%; height:100%; margin:0; cursor:pointer; z-index:2}
.switch .track{position:absolute; inset:0; border-radius:99px; background:#dcdad0; transition:.2s}
.switch .knob{position:absolute; top:3px; left:3px; width:16px; height:16px; border-radius:50%; background:#fff; transition:.2s; box-shadow:0 1px 3px rgba(0,0,0,.2)}
.switch input:checked ~ .track{background:var(--brand)}
.switch input:checked ~ .knob{transform:translateX(16px)}
.mini-input{width:64px; height:30px; padding:0 8px; border-radius:8px; border:1px solid var(--line); background:#fcfcfa; font-family:var(--mono); font-size:11.5px; text-align:center; outline:none}
.mini-input:focus{border-color:var(--brand-2)}

/* ---------- footer ---------- */
footer{margin-top:38px; padding-top:18px; border-top:1px solid var(--line); display:flex; flex-wrap:wrap; gap:8px; align-items:center; justify-content:space-between}
footer p{font-size:11px; color:var(--muted-2); font-weight:600}
footer .badge{display:inline-flex; align-items:center; gap:5px; font-size:10.5px; font-weight:700; color:var(--muted); background:#fff; border:1px solid var(--line); border-radius:999px; padding:3px 9px}

/* ---------- drawer ---------- */
.overlay{position:fixed; inset:0; background:rgba(10,31,28,.42); backdrop-filter:blur(2px); opacity:0; pointer-events:none; transition:.24s; z-index:70}
.overlay.show{opacity:1; pointer-events:auto}
.drawer{
  position:fixed; top:0; right:0; bottom:0; width:min(310px,86vw); z-index:80;
  background:#fff; border-left:1px solid var(--line);
  transform:translateX(102%); transition:transform .28s cubic-bezier(.4,0,.2,1);
  display:flex; flex-direction:column; box-shadow:-20px 0 60px -30px rgba(10,31,28,.5);
}
.drawer.show{transform:none}
.drawer-head{padding:18px 18px 14px; border-bottom:1px solid var(--line-2); display:flex; align-items:center; justify-content:space-between}
.drawer-head .t{font-size:13px; font-weight:800; letter-spacing:-.2px}
.drawer-body{padding:14px 12px; overflow:auto; flex:1}
.dnav{display:grid; gap:2px}
.dnav a{
  display:flex; align-items:center; gap:10px; padding:10px 11px; border-radius:10px;
  color:var(--ink); font-size:12.5px; font-weight:600; transition:.15s;
}
.dnav a:hover{background:var(--brand-soft); color:#0b5d55}
.dnav a .n{font-family:var(--mono); font-size:10px; color:var(--muted-2); margin-left:auto}
.dsec{font-size:9.5px; font-weight:800; letter-spacing:.14em; text-transform:uppercase; color:var(--muted-2); padding:14px 11px 6px}
.drawer-foot{padding:12px 14px; border-top:1px solid var(--line-2); font-size:10.5px; color:var(--muted-2); font-weight:600}

/* ---------- modal ---------- */
.modal{position:fixed; inset:0; z-index:90; display:none; place-items:center; padding:18px; background:rgba(10,31,28,.5); backdrop-filter:blur(3px)}
.modal.show{display:grid}
.modal-card{width:100%; max-width:360px; background:#fff; border-radius:20px; padding:24px; box-shadow:var(--shadow-lg); animation:pop .22s ease}
@keyframes pop{from{opacity:0; transform:scale(.96) translateY(6px)} to{opacity:1; transform:none}}
.modal-card h3{font-size:16px; font-weight:800; letter-spacing:-.3px}
.modal-card p{font-size:12px; color:var(--muted); margin-top:5px}
.modal-card .field{margin-top:14px}

/* ---------- toast ---------- */
#toasts{position:fixed; left:50%; bottom:20px; transform:translateX(-50%); z-index:100; display:grid; gap:8px; width:min(360px,calc(100vw - 28px))}
.toast{
  display:flex; align-items:center; gap:9px; padding:11px 13px; border-radius:12px;
  background:#0a1f1c; color:#e8f5f2; font-size:12px; font-weight:600;
  box-shadow:0 18px 40px -18px rgba(0,0,0,.6); animation:tin .24s ease;
}
.toast .d{width:7px; height:7px; border-radius:50%; background:#5eead4; flex:0 0 auto}
.toast.err .d{background:#ff8f7a}
@keyframes tin{from{opacity:0; transform:translateY(10px)} to{opacity:1; transform:none}}

/* ---------- misc ---------- */
.empty{text-align:center; padding:34px 18px; background:#fff; border:1px dashed var(--line); border-radius:var(--r); color:var(--muted); font-size:12.5px}
.hidden{display:none !important}
.mono{font-family:var(--mono)}
.sr{position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0)}
@media(prefers-reduced-motion:reduce){ *{animation:none !important; transition:none !important} }
</style>
</head>
<body>

<nav class="topbar">
  <div class="topbar-inner">
    <div class="brand">
      <div class="brand-mark">VP</div>
      <div>
        <div class="brand-name">Vincent Pay</div>
        <div class="brand-sub">QRIS Control</div>
      </div>
    </div>
    <div class="topbar-right">
      <span class="pill hide-sm" id="pillGopay"><span class="dot"></span><span class="lbl">GoPay</span></span>
      <span class="pill hide-sm" id="pillShopee"><span class="dot"></span><span class="lbl">Shopee</span></span>
      <button class="icon-btn" id="menuBtn" aria-label="Buka menu" aria-expanded="false" aria-controls="drawer">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</nav>

<main>
  <!-- HERO -->
  <header class="hero">
    <div class="hero-mark">VP</div>
    <h1>Vincent Pay × GoMerch × ShopeePay</h1>
    <p class="sub">Satu dashboard untuk QRIS dinamis, cek mutasi, dan login OTP dua provider.</p>
    <div class="accent-line"></div>
    <div class="search-wrap">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input type="text" id="searchInput" class="search-input" placeholder="Cari endpoint, mis. otp, mutasi, refresh…" autocomplete="off" aria-label="Cari endpoint">
    </div>
    <div class="hero-stats">
      <div class="hstat"><div class="k">GoPay</div><div class="v" id="hsGopay">memuat…</div></div>
      <div class="hstat"><div class="k">ShopeePay</div><div class="v" id="hsShopee">memuat…</div></div>
      <div class="hstat"><div class="k">Mode</div><div class="v" id="hsMode"><%= locked ? 'Terkunci' : 'Publik' %></div></div>
    </div>
  </header>

  <!-- GOPAY -->
  <section class="section" id="sec-gopay">
    <div class="section-head">
      <div>
        <div class="lbl">Provider 01</div>
        <h2>GoPay Merchant</h2>
      </div>
      <span class="count" data-count="gopay">0 endpoint</span>
    </div>
    <p class="section-desc">Login OTP GoBiz, perpanjang token, dan tarik mutasi QRIS 7 hari terakhir.</p>
    <div id="list-gopay"></div>
  </section>

  <!-- SHOPEE -->
  <section class="section" id="sec-shopee">
    <div class="section-head">
      <div>
        <div class="lbl">Provider 02</div>
        <h2>ShopeePay Partner</h2>
      </div>
      <span class="count" data-count="shopee">0 endpoint</span>
    </div>
    <p class="section-desc">Alur OTP yang sudah diperbaiki: diagnosa device-risk dulu, baru kirim OTP — jadi kelihatan persis di langkah mana Shopee menolak.</p>

    <!-- OTP FLOW -->
    <div class="flow" id="otpFlow">
      <div class="flow-head">
        <div class="lbl">Alur utama</div>
        <h3>Login OTP ShopeePay</h3>
        <p>Empat langkah, semuanya menampilkan jejak langkah server. Kalau OTP tidak sampai, langkah yang gagal langsung ditandai beserta kode error dan cara memperbaikinya.</p>
      </div>
      <div class="steps">

        <!-- step 1 -->
        <div class="step active" id="st1">
          <div class="step-num">1</div>
          <div class="step-title">Diagnosa <span>aman, tidak mengirim OTP</span></div>
          <div class="step-body">
            <div class="fields">
              <div class="field">
                <label>Nomor HP <span class="req">*</span></label>
                <input id="f-phone" placeholder="0812xxxxxxx" inputmode="tel" autocomplete="tel">
              </div>
              <div class="field">
                <label>Password <span style="text-transform:none;font-weight:600;color:var(--muted-2)">(kalau akun pakai)</span></label>
                <input id="f-pass" type="password" placeholder="password akun Shopee" autocomplete="current-password">
              </div>
            </div>
            <div class="actions">
              <button class="btn btn-primary" id="btnDiag">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 12h4l2 6 4-14 2 8h6"/></svg>
                Jalankan diagnosa
              </button>
              <button class="btn btn-ghost btn-sm" id="btnDiagHelp">Kenapa perlu?</button>
            </div>
            <div class="resp" id="diagResp"></div>
          </div>
        </div>

        <!-- step 2 -->
        <div class="step locked" id="st2">
          <div class="step-num">2</div>
          <div class="step-title">Kirim OTP <span>pilih channel</span></div>
          <div class="step-body">
            <div class="fields">
              <div class="field">
                <label>Channel OTP</label>
                <select id="f-channel">
                  <option value="">Otomatis (default Shopee)</option>
                  <option value="1">1 — SMS</option>
                  <option value="2">2 — Email</option>
                  <option value="3">3 — WhatsApp</option>
                  <option value="5">5 — Aplikasi</option>
                </select>
              </div>
              <div class="field">
                <label>captcha_signature <span style="text-transform:none;font-weight:600;color:var(--muted-2)">(opsional)</span></label>
                <input id="f-captcha" placeholder="dari request send_otp yang sukses">
              </div>
            </div>
            <div class="actions">
              <button class="btn btn-primary" id="btnOtp">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4Z"/></svg>
                Kirim OTP
              </button>
            </div>
            <div class="resp" id="otpResp"></div>
          </div>
        </div>

        <!-- step 3 -->
        <div class="step locked" id="st3">
          <div class="step-num">3</div>
          <div class="step-title">Verifikasi kode <span>4–10 digit</span></div>
          <div class="step-body">
            <div class="fields">
              <div class="field">
                <label>Kode OTP <span class="req">*</span></label>
                <input id="f-otp" placeholder="123456" inputmode="numeric" autocomplete="one-time-code" maxlength="10">
              </div>
              <div class="field">
                <label>Simpan di server</label>
                <select id="f-save">
                  <option value="1">Ya — token dipakai dashboard &amp; bot</option>
                  <option value="0">Tidak — hanya tampilkan token</option>
                </select>
              </div>
            </div>
            <div class="actions">
              <button class="btn btn-primary" id="btnVerify">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m5 13 4 4L19 7"/></svg>
                Verifikasi
              </button>
            </div>
            <div class="resp" id="verifyResp"></div>
            <div id="merchantPick"></div>
          </div>
        </div>

        <!-- step 4 -->
        <div class="step locked" id="st4">
          <div class="step-num">4</div>
          <div class="step-title">Token merchant <span>siap dipakai</span></div>
          <div class="step-body">
            <div id="tokenOut"></div>
          </div>
        </div>

      </div>
    </div>

    <div id="list-shopee"></div>
  </section>

  <!-- PEMBAYARAN -->
  <section class="section" id="sec-pay">
    <div class="section-head">
      <div>
        <div class="lbl">Operasional</div>
        <h2>Pembayaran &amp; Mutasi</h2>
      </div>
      <span class="count" data-count="pay">0 endpoint</span>
    </div>
    <p class="section-desc">Buat QRIS dinamis dari QRIS statis, lalu cek status bayar dengan pencocokan nominal + waktu.</p>
    <div id="list-pay"></div>
  </section>

  <!-- AUTO REFRESH -->
  <section class="section" id="sec-auto">
    <div class="section-head">
      <div>
        <div class="lbl">Perawatan</div>
        <h2>Auto Refresh Token</h2>
      </div>
      <span class="count" id="loopBadge">—</span>
    </div>
    <p class="section-desc">Token diperpanjang sebelum kedaluwarsa. Di Vercel tidak ada proses hidup terus, jadi tick dipanggil dashboard selama halaman terbuka.</p>
    <div class="grid2" id="autoGrid">
      <div class="stat-card" data-prov="gopay">
        <div class="top">
          <div class="name">GoPay Merchant</div>
          <label class="switch"><input type="checkbox" data-auto-toggle><span class="track"></span><span class="knob"></span></label>
        </div>
        <div class="rows">
          <div class="srow"><span class="k">Token</span><span class="v" data-k="token">—</span></div>
          <div class="srow"><span class="k">Sisa umur</span><span class="v" data-k="left">—</span></div>
          <div class="srow"><span class="k">Refresh terakhir</span><span class="v" data-k="last">—</span></div>
          <div class="srow"><span class="k">Interval</span><span class="v"><input class="mini-input" data-auto-min type="number" min="5" max="720" step="5"> mnt</span></div>
        </div>
        <div class="actions">
          <button class="btn btn-ghost btn-sm" data-refresh>Refresh sekarang</button>
          <button class="btn btn-ghost btn-sm" data-save>Simpan</button>
        </div>
      </div>
      <div class="stat-card" data-prov="shopee">
        <div class="top">
          <div class="name">ShopeePay Partner</div>
          <label class="switch"><input type="checkbox" data-auto-toggle><span class="track"></span><span class="knob"></span></label>
        </div>
        <div class="rows">
          <div class="srow"><span class="k">Token</span><span class="v" data-k="token">—</span></div>
          <div class="srow"><span class="k">Sisa umur</span><span class="v" data-k="left">—</span></div>
          <div class="srow"><span class="k">Refresh terakhir</span><span class="v" data-k="last">—</span></div>
          <div class="srow"><span class="k">Interval</span><span class="v"><input class="mini-input" data-auto-min type="number" min="5" max="720" step="5"> mnt</span></div>
        </div>
        <div class="actions">
          <button class="btn btn-ghost btn-sm" data-refresh>Refresh sekarang</button>
          <button class="btn btn-ghost btn-sm" data-save>Simpan</button>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>© 2026 Vincent Pay — dashboard internal</p>
    <span class="badge">
      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 2 4 6v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V6Z"/></svg>
      <%= persistent ? 'Penyimpanan permanen' : 'Penyimpanan sementara (/tmp)' %>
    </span>
  </footer>
</main>

