<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Vincent Pay × GoMerch × ShopeePay</title>
<style>
:root{
  --bg:#f5f4f0;--panel:#fff;--line:#dedbd3;--ink:#1d1c1a;--mute:#6d6a63;--soft:#eceae4;
  --go:#00850f;--sh:#d2310f;--ok:#12803a;--err:#c62828;--warn:#8a6100;--warnbg:#fff4d6;
  --c:var(--ink);
}
@media(prefers-color-scheme:dark){:root{
  --bg:#151513;--panel:#1d1d1a;--line:#33322d;--ink:#ecebe6;--mute:#9b988f;--soft:#262622;
  --go:#2fb344;--sh:#f0663f;--ok:#4cc27a;--err:#ff7b72;--warn:#e5b83c;--warnbg:#2c2614;
}}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif}
a{color:inherit}
.wrap{max-width:960px;margin:0 auto;padding:0 20px}
header{border-bottom:1px solid var(--line);background:var(--panel)}
.top{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:14px 0 0}
.brand{font-weight:650;font-size:17px;letter-spacing:-.01em}
.brand small{font-weight:400;color:var(--mute);font-size:13px;margin-left:8px}
.tabs{display:flex;gap:2px;margin-top:10px;overflow-x:auto}
.tab{background:none;border:0;border-bottom:2px solid transparent;padding:9px 14px;font:inherit;color:var(--mute);cursor:pointer;white-space:nowrap}
.tab:hover{color:var(--ink)}
.tab[aria-current=page]{color:var(--ink);border-bottom-color:var(--c);font-weight:600}
.tab[data-v=gopay]{--c:var(--go)}.tab[data-v=shopee]{--c:var(--sh)}
main.wrap{padding:28px 20px 56px}
section[hidden]{display:none}
h1{font-size:22px;margin:0 0 4px;letter-spacing:-.015em}
h2{font-size:16px;margin:0 0 2px}
.lead{color:var(--mute);margin:0 0 22px;max-width:60ch}
.pv{--c:var(--go)}.pv.shopee{--c:var(--sh)}
.cols{display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(min(100%,400px),1fr));margin-bottom:16px;align-items:start}
.box{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:18px}
.sub{color:var(--mute);font-size:13.5px;margin:0 0 12px}
label{display:block;font-size:13px;color:var(--mute);margin:12px 0 4px}
input,textarea{width:100%;border:1px solid var(--line);border-radius:6px;padding:8px 10px;font:inherit;background:var(--bg);color:var(--ink)}
textarea{font:12px/1.4 ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;min-height:54px;resize:vertical}
input:focus,textarea:focus,button:focus-visible{outline:2px solid var(--c);outline-offset:1px}
.btn{font:inherit;font-weight:600;border:1px solid var(--c);background:var(--c);color:#fff;border-radius:6px;padding:8px 14px;cursor:pointer}
.btn:hover{filter:brightness(1.08)}
.btn:disabled{opacity:.55;cursor:wait}
.btn.ghost{background:transparent;color:var(--ink);border-color:var(--line);font-weight:500}
.btn.ghost:hover{background:var(--soft);filter:none}
.btn.sm{padding:4px 10px;font-size:13px}
.btn.full{width:100%;margin-top:14px}
.quick{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.msg{font-size:13.5px;margin-top:8px;min-height:1.2em}
.row{display:flex;align-items:center;justify-content:space-between;gap:10px}
.dot{display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--mute);margin-right:12px}
.dot:before{content:"";width:8px;height:8px;border-radius:50%;background:var(--err)}
.dot.on:before{background:var(--ok)}
.qrbox{min-height:300px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center}
.qrbox img{width:100%;max-width:260px;border:1px solid var(--line);border-radius:6px;background:#fff;padding:6px}
.amt{font-size:26px;font-weight:650;margin:12px 0 4px;letter-spacing:-.02em}
.state{font-size:13.5px;padding:3px 10px;border-radius:99px;background:var(--soft);color:var(--mute)}
.state.ok{background:color-mix(in srgb,var(--ok) 16%,transparent);color:var(--ok)}
.state.bad{background:color-mix(in srgb,var(--err) 14%,transparent);color:var(--err)}
.note{background:var(--warnbg);color:var(--warn);border-radius:6px;padding:8px 10px;font-size:13px;margin-bottom:12px}
.lock{background:var(--soft);border-radius:6px;padding:10px 12px;color:var(--mute);font-size:13.5px}
.tw{overflow-x:auto;margin:0 -4px}
table{width:100%;border-collapse:collapse;font-size:14px}
th{font-weight:500;color:var(--mute);font-size:12.5px}
th,td{text-align:left;padding:8px 6px;border-bottom:1px solid var(--line);white-space:nowrap}
tr:last-child td{border-bottom:0}
td.m,.mono{font:12.5px ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
details{margin-top:14px;border-top:1px solid var(--line);padding-top:10px}
summary{cursor:pointer;color:var(--mute);font-size:13.5px}
.pick{display:grid;gap:6px;margin-top:10px}
.steps{margin:0;padding-left:18px;color:var(--mute)}
.steps li{margin:4px 0}
.status-tbl td:first-child{font-weight:600}
dialog{border:1px solid var(--line);border-radius:10px;padding:20px;width:min(380px,92vw);background:var(--panel);color:var(--ink)}
dialog::backdrop{background:#0008}
footer{color:var(--mute);font-size:12.5px;padding:0 0 32px}
</style>
</head>
<body>
<header>
 <div class="wrap">
  <div class="top">
   <div class="brand">Vincent Pay<small>× GoMerch × ShopeePay</small></div>
   <button class="btn ghost sm" id="adm"><%- admin ? 'Keluar admin' : 'Masuk admin' %></button>
  </div>
  <nav class="tabs" aria-label="Menu">
   <button class="tab" data-v="home">Beranda</button>
   <button class="tab" data-v="gopay">GoMerch</button>
   <button class="tab" data-v="shopee">ShopeePay</button>
   <button class="tab" data-v="api">API</button>
  </nav>
 </div>
</header>

<main class="wrap">
 <section id="v-home">
  <h1>Vincent Pay</h1>
  <p class="lead">Kasir QRIS yang ngecek pembayaran masuk di GoPay Merchant (GoMerch) dan ShopeePay Partner. Dua-duanya jalan di satu sistem.</p>
  <div class="box" style="margin-bottom:16px">
   <h2>Status koneksi</h2>
   <div class="tw"><table class="status-tbl"><tbody>
    <tr><td>GoMerch</td><td id="hs-gopay"><%- admin ? '...' : '<span class="mono" style="color:var(--mute)">login admin untuk lihat</span>' %></td><td style="text-align:right"><button class="btn ghost sm" data-go="gopay">Buka</button></td></tr>
    <tr><td>ShopeePay</td><td id="hs-shopee"><%- admin ? '...' : '<span class="mono" style="color:var(--mute)">login admin untuk lihat</span>' %></td><td style="text-align:right"><button class="btn ghost sm" data-go="shopee">Buka</button></td></tr>
   </tbody></table></div>
  </div>
  <div class="box">
   <h2>Cara pakai</h2>
   <ol class="steps">
    <li>Masuk admin (pojok kanan atas).</li>
    <li>Di menu GoMerch atau ShopeePay, login pakai OTP dan isi QRIS statis tokomu.</li>
    <li>Di bagian Kasir, isi nominal lalu Buat QRIS. Status pembayaran dicek otomatis.</li>
   </ol>
  </div>
 </section>
 <section id="v-gopay" class="pv" hidden></section>
 <section id="v-shopee" class="pv shopee" hidden></section>
 <section id="v-api" hidden>
  <h1>API</h1>
  <p class="lead">Satu set endpoint untuk dua provider. Kirim <span class="mono">provider</span> berisi <span class="mono">gopay</span> atau <span class="mono">shopee</span>.</p>
  <div class="box"><div class="tw"><table><thead><tr><th>Method</th><th>Endpoint</th><th>Body / akses</th><th></th></tr></thead><tbody id="apis"></tbody></table></div></div>
 </section>
</main>
<div class="wrap"><footer>Integrasi tidak resmi, tidak berafiliasi dengan Gojek maupun Shopee. Dipakai untuk akun merchant sendiri.</footer></div>

<dialog id="dlg"><form method="dialog" onsubmit="return false">
 <div class="row"><h2>Masuk admin</h2><button class="btn ghost sm" type="button" onclick="dlg.close()">Tutup</button></div>
 <label for="pw">Password</label><input id="pw" type="password" autocomplete="current-password">
 <button class="btn full" id="dologin" style="--c:var(--ink)">Masuk</button><div class="msg" id="lmsg" style="color:var(--err)"></div>
</form></dialog>

<script>
const ADMIN=<%- admin ? 'true' : 'false' %>, PERSIST=<%- persistent ? 'true' : 'false' %>;
const PV={gopay:{n:'GoMerch',f:'GoPay Merchant'},shopee:{n:'ShopeePay',f:'ShopeePay Partner'}};
const $=(s,r=document)=>r.querySelector(s), rp=n=>'Rp '+Number(n).toLocaleString('id-ID');
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const errTxt=e=>typeof e==='string'?e:JSON.stringify(e);
async function api(u,b){try{const r=await fetch(u,b?{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(b)}:{});return await r.json()}catch(e){return{success:false,error:e.message}}}
const timers={}; let otpTok='', shChal='', shVer='';
const say=(el,ok,t)=>{el.style.color=ok?'var(--ok)':'var(--err)';el.textContent=t};

const lock='<div class="lock">Khusus admin. Klik <b>Masuk admin</b> dulu.</div>';
const warnTmp='<div class="note">Server ini jalan di Vercel, jadi data disimpan di /tmp dan bisa hilang kalau instance restart. Biar permanen, jalankan di VPS atau panel.</div>';

function otpCard(p){
 if(!ADMIN)return `<div class="box"><h2>Login OTP</h2><p class="sub">Cara paling gampang buat dapat token.</p>${lock}</div>`;
 if(p==='gopay')return `<div class="box"><h2>Login OTP</h2><p class="sub">OTP dikirim ke nomor merchant. Token tersimpan dan diperpanjang otomatis.</p>
  <label for="ph">Nomor HP merchant</label><input id="ph" type="tel" placeholder="0812xxxxxxx">
  <button class="btn ghost full" id="otpreq">Kirim OTP</button>
  <label for="otp">Kode OTP</label><input id="otp" inputmode="numeric" autocomplete="one-time-code">
  <button class="btn full" id="otpver">Verifikasi dan simpan</button><div class="msg" id="otpmsg"></div></div>`;
 return `<div class="box"><h2>Login OTP</h2><p class="sub">Login pakai akun Shopee Partner. Token diperpanjang sendiri selama sesi akunnya hidup, jadi tidak perlu tempel token manual.</p>
  <label for="s-ph">Nomor HP akun Partner</label><input id="s-ph" type="tel" placeholder="0812xxxxxxx">
  <label for="s-pw">Password (isi hanya kalau akunmu pakai password)</label><input id="s-pw" type="password" autocomplete="off">
  <button class="btn ghost full" id="s-req">Kirim OTP</button>
  <label for="s-otp">Kode OTP</label><input id="s-otp" inputmode="numeric" autocomplete="one-time-code">
  <button class="btn full" id="s-ver">Verifikasi dan simpan</button>
  <div class="pick" id="s-pick"></div><div class="msg" id="s-msg"></div>
  <div class="row" style="margin-top:8px"><span class="sub" id="s-who" style="margin:0"></span><button class="btn ghost sm" id="s-out" hidden>Putuskan</button></div></div>`;
}
function page(p){
 const v=PV[p];
 return `
 <h1>${v.n}</h1><p class="lead">${v.f}. Kasir QRIS, koneksi akun, dan riwayat transaksi.</p>
 <div class="cols">
  <div class="box"><h2>Kasir</h2><p class="sub">Bikin QRIS dinamis. Status dicek tiap 4 detik, berlaku 15 menit.</p>
   <label for="${p}-amt">Nominal (Rp)</label><input id="${p}-amt" type="number" min="1" inputmode="numeric" placeholder="15000">
   <div class="quick">${[10000,25000,50000,100000].map(n=>`<button class="btn ghost sm" data-chip="${p}" data-n="${n}">${n.toLocaleString('id-ID')}</button>`).join('')}</div>
   <button class="btn full" data-create="${p}">Buat QRIS</button><div class="msg" id="${p}-cmsg"></div></div>
  <div class="box qrbox" aria-live="polite"><div id="${p}-qr"><span class="sub">QRIS muncul di sini.</span></div></div>
 </div>
 <div class="cols">
  ${otpCard(p)}
  <div class="box"><div class="row"><h2>Koneksi</h2><span id="${p}-pills"></span></div>
   <p class="sub">Token dan QRIS statis disimpan di server dan tidak ditampilkan lagi.</p>
   ${ADMIN?`${PERSIST?'':warnTmp}
   <label for="${p}-qs">QRIS statis</label><textarea id="${p}-qs" placeholder="000201010211..."></textarea>
   <details><summary>Isi token manual</summary>
   ${p==='gopay'?`<label for="at">Access token</label><textarea id="at"></textarea><label for="rt">Refresh token</label><textarea id="rt"></textarea>`:`<label for="st">Token Partner Portal (B:...)</label><textarea id="st"></textarea>`}
   </details>
   <button class="btn full" data-save="${p}">Simpan</button><div class="msg" id="${p}-amsg"></div>`:lock}</div>
 </div>
 <div class="box"><div class="row"><div><h2>Riwayat 7 hari</h2><p class="sub" style="margin:0">Transaksi masuk ${v.n}</p></div>${ADMIN?`<button class="btn ghost sm" data-hist="${p}">Muat ulang</button>`:''}</div>
  ${ADMIN?`<div class="tw"><table><thead><tr><th>Waktu</th><th>Nominal</th><th>Status</th><th>ID</th></tr></thead><tbody id="${p}-rows"><tr><td colspan="4">Memuat...</td></tr></tbody></table></div>`:`<div style="margin-top:12px">${lock}</div>`}</div>`;
}
$('#v-gopay').innerHTML=page('gopay');$('#v-shopee').innerHTML=page('shopee');

const APIS=[['POST','/api/pay/create','provider, amount'],['POST','/api/pay/check','provider, amount, created_at'],['GET','/api/pay/history?provider=gopay','admin'],
 ['POST','/api/gopay/otp','admin: phone'],['POST','/api/gopay/verify','admin: otp, otp_token'],
 ['POST','/api/shopee/otp','admin: phone, password?'],['POST','/api/shopee/verify','admin: challenge, otp'],['POST','/api/shopee/select','admin: verification, merchant_id'],
 ['POST','/api/admin/config','admin: provider, token, qris'],['GET','/api/health','publik']];
$('#apis').innerHTML=APIS.map(a=>`<tr><td><b>${a[0]}</b></td><td class="m">${a[1]}</td><td class="m">${a[2]}</td><td><button class="btn ghost sm" data-copy="${location.origin}${a[1]}">Salin</button></td></tr>`).join('');

function show(v){
 if(!PV[v]&&v!=='api')v='home';
 ['home','gopay','shopee','api'].forEach(k=>$('#v-'+k).hidden=k!==v);
 document.querySelectorAll('.tab').forEach(t=>{t.dataset.v===v?t.setAttribute('aria-current','page'):t.removeAttribute('aria-current')});
 if(location.hash!=='#'+v)history.replaceState(null,'','#'+v);
 if(ADMIN&&PV[v])hist(v);
}
document.querySelectorAll('.tab').forEach(t=>t.onclick=()=>show(t.dataset.v));
document.addEventListener('click',e=>{
 const b=e.target.closest('button');if(!b)return;
 if(b.dataset.go)show(b.dataset.go);
 if(b.dataset.chip)$('#'+b.dataset.chip+'-amt').value=b.dataset.n;
 if(b.dataset.create)create(b.dataset.create,b);
 if(b.dataset.save)save(b.dataset.save,b);
 if(b.dataset.hist)hist(b.dataset.hist);
 if(b.dataset.copy)navigator.clipboard.writeText(b.dataset.copy).then(()=>{b.textContent='Tersalin';setTimeout(()=>b.textContent='Salin',1200)});
});

async function create(p,btn){
 clearInterval(timers[p]);const m=$('#'+p+'-cmsg');m.textContent='';btn.disabled=true;
 const d=await api('/api/pay/create',{provider:p,amount:$('#'+p+'-amt').value});btn.disabled=false;
 if(!d.success){say(m,false,d.error);return}
 const end=Date.now()+d.expires_in*1000, box=$('#'+p+'-qr');
 box.innerHTML=`<img src="${d.image}" alt="QRIS ${rp(d.amount)}"><div class="amt">${rp(d.amount)}</div><span class="state" id="${p}-st">Menunggu pembayaran</span>`;
 const st=$('#'+p+'-st');
 timers[p]=setInterval(async()=>{
  if(Date.now()>end){clearInterval(timers[p]);st.className='state bad';st.textContent='QRIS kedaluwarsa';return}
  const c=await api('/api/pay/check',{provider:p,amount:d.amount,created_at:d.created_at});
  if(c.status==='PAID'){clearInterval(timers[p]);st.className='state ok';st.textContent='Pembayaran diterima';if(ADMIN)hist(p)}
  else if(!c.success){st.className='state bad';st.textContent=c.error}
 },4000);
}
async function save(p,btn){
 const body={provider:p,qris:$('#'+p+'-qs').value};
 if(p==='gopay'){body.accessToken=$('#at').value;body.refreshToken=$('#rt').value}else body.token=$('#st').value;
 btn.disabled=true;const d=await api('/api/admin/config',body);btn.disabled=false;
 const m=$('#'+p+'-amsg');say(m,d.success,d.success?'Tersimpan.':d.error);
 if(d.success){document.querySelectorAll('#v-'+p+' textarea').forEach(t=>t.value='');status()}
}
async function hist(p){
 const tb=$('#'+p+'-rows');if(!tb)return;
 const d=await api('/api/pay/history?provider='+p);
 if(!d.success){tb.innerHTML=`<tr><td colspan="4" style="color:var(--err);white-space:normal">${esc(errTxt(d.error))}</td></tr>`;return}
 tb.innerHTML=d.data.length?d.data.map(t=>`<tr><td>${new Date(t.time).toLocaleString('id-ID')}</td><td>${rp(t.amount)}</td><td>${esc(t.status||'-')}</td><td class="m">${esc(String(t.id).slice(-10))}</td></tr>`).join(''):'<tr><td colspan="4">Belum ada transaksi.</td></tr>';
}
async function status(){
 if(!ADMIN)return;
 const d=await api('/api/admin/status');if(!d.success)return;
 for(const p of ['gopay','shopee']){
  const s=d[p],h=`<span class="dot ${s.token?'on':''}">Token ${s.token?'tersambung':'kosong'}</span><span class="dot ${s.qris?'on':''}">QRIS ${s.qris?'siap':'kosong'}</span>`;
  $('#'+p+'-pills').innerHTML=h;$('#hs-'+p).innerHTML=h;
 }
 const who=$('#s-who'),out=$('#s-out');
 if(who){who.textContent=d.shopee.otp?('Terhubung sebagai '+(d.shopee.merchant||'merchant')):'';out.hidden=!d.shopee.otp}
}

// OTP GoMerch + ShopeePay
document.addEventListener('click',async e=>{
 const id=e.target.id, btn=e.target;
 if(id==='otpreq'){const m=$('#otpmsg');btn.disabled=true;const d=await api('/api/gopay/otp',{phone:$('#ph').value});btn.disabled=false;
  if(d.success){otpTok=d.otp_token;say(m,true,'OTP dikirim.')}else say(m,false,errTxt(d.error))}
 if(id==='otpver'){const m=$('#otpmsg');if(!otpTok)return say(m,false,'Kirim OTP dulu.');
  const d=await api('/api/gopay/verify',{otp:$('#otp').value,otp_token:otpTok});
  say(m,d.success,d.success?'Berhasil, token tersimpan.':errTxt(d.error));if(d.success)status()}
 if(id==='s-req'){const m=$('#s-msg');btn.disabled=true;
  const d=await api('/api/shopee/otp',{phone:$('#s-ph').value,password:$('#s-pw').value});btn.disabled=false;
  if(d.success){shChal=d.challenge;say(m,true,'OTP dikirim lewat '+({1:'SMS',2:'telepon',3:'WhatsApp',4:'email',5:'Zalo'}[d.channel]||'channel #'+d.channel)+'.')}else say(m,false,errTxt(d.error))}
 if(id==='s-ver'){const m=$('#s-msg');if(!shChal)return say(m,false,'Kirim OTP dulu.');btn.disabled=true;
  const d=await api('/api/shopee/verify',{challenge:shChal,otp:$('#s-otp').value});btn.disabled=false;
  if(!d.success)return say(m,false,errTxt(d.error));
  if(d.select){shVer=d.verification;say(m,true,'Ada beberapa merchant, pilih salah satu:');
   $('#s-pick').innerHTML=d.merchants.map(x=>`<button class="btn ghost" data-pick="${esc(x.id)}">${esc(x.name||x.id)}</button>`).join('');return}
  say(m,true,'Berhasil login sebagai '+d.merchant+'.');shChal='';status()}
 if(e.target.dataset&&e.target.dataset.pick){const m=$('#s-msg');
  const d=await api('/api/shopee/select',{verification:shVer,merchant_id:e.target.dataset.pick});
  if(d.success){$('#s-pick').innerHTML='';say(m,true,'Berhasil login sebagai '+d.merchant+'.');shVer='';shChal='';status()}else say(m,false,errTxt(d.error))}
 if(id==='s-out'){await api('/api/shopee/logout',{});say($('#s-msg'),true,'Koneksi ShopeePay diputus.');status()}
});
const dlg=$('#dlg');
$('#adm').onclick=async()=>{if(ADMIN){await api('/api/admin/logout',{});location.reload()}else dlg.showModal()};
$('#dologin').onclick=async()=>{const d=await api('/api/admin/login',{password:$('#pw').value});if(d.success)location.reload();else $('#lmsg').textContent=d.error};
$('#pw').onkeydown=e=>{if(e.key==='Enter')$('#dologin').click()};
show(location.hash.slice(1));status();
</script>
</body>
</html>
