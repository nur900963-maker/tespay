<div id="toasts"></div>

<script>
window.__BOOT = {
  admin: <%- JSON.stringify(!!admin) %>,
  locked: <%- JSON.stringify(!!locked) %>,
  persistent: <%- JSON.stringify(!!persistent) %>
};
</script>
<script>
(function(){
'use strict';

/* ============================================================
   util
   ============================================================ */
const $  = (s, r) => (r || document).querySelector(s);
const $$ = (s, r) => Array.from((r || document).querySelectorAll(s));
const esc = s => String(s == null ? '' : s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

function toast(msg, kind){
  const box = $('#toasts');
  const t = document.createElement('div');
  t.className = 'toast' + (kind === 'err' ? ' err' : '');
  t.innerHTML = '<span class="d"></span><span>' + esc(msg) + '</span>';
  box.appendChild(t);
  setTimeout(() => { t.style.opacity = '0'; t.style.transform = 'translateY(8px)'; t.style.transition = '.25s'; }, 3200);
  setTimeout(() => t.remove(), 3600);
}

function fmtLeft(ms){
  if (ms == null) return '—';
  if (ms <= 0) return 'kedaluwarsa';
  const m = Math.floor(ms / 60000);
  if (m < 60) return m + ' mnt';
  const h = Math.floor(m / 60);
  if (h < 24) return h + ' jam ' + (m % 60) + ' mnt';
  return Math.floor(h / 24) + ' hari';
}
function fmtAgo(ms){
  if (ms == null) return '—';
  const m = Math.floor(ms / 60000);
  if (m < 1) return 'baru saja';
  if (m < 60) return m + ' mnt lalu';
  const h = Math.floor(m / 60);
  if (h < 24) return h + ' jam lalu';
  return Math.floor(h / 24) + ' hari lalu';
}

/* ============================================================
   api
   ============================================================ */
let loginResolve = null;
function showLogin(){
  $('#loginModal').classList.add('show');
  setTimeout(() => $('#loginPass').focus(), 60);
  return new Promise(res => { loginResolve = res; });
}

async function api(path, body, method){
  method = method || (body === undefined ? 'GET' : 'POST');
  const t0 = performance.now();
  let r, txt;
  try {
    r = await fetch(path, {
      method,
      credentials: 'same-origin',
      headers: method === 'GET' ? {} : { 'Content-Type': 'application/json' },
      body: method === 'GET' ? undefined : JSON.stringify(body || {})
    });
    txt = await r.text();
  } catch (e) {
    return { ok: false, status: 0, data: { success: false, error: 'Tidak bisa menghubungi server: ' + e.message }, ms: 0 };
  }
  let data;
  try { data = JSON.parse(txt); } catch (e) { data = { success: false, error: 'Balasan bukan JSON', raw: txt.slice(0, 400) }; }
  if (r.status === 401 && window.__BOOT.locked) {
    await showLogin();
    return api(path, body, method);
  }
  return { ok: r.ok, status: r.status, data, ms: Math.round(performance.now() - t0) };
}

/* ============================================================
   response renderer
   ============================================================ */
function renderResp(box, res, opts){
  opts = opts || {};
  box.classList.add('show');
  const cls = res.status >= 500 ? 's5' : (res.status >= 400 ? 's4' : 's2');
  const label = res.ok ? 'OK' : 'GAGAL';
  let html = '<div class="resp-bar">'
    + '<span class="tag ' + cls + '">' + res.status + ' ' + label + '</span>'
    + '<span>' + res.ms + ' ms</span>'
    + (opts.note ? '<span style="margin-left:auto;font-weight:600">' + esc(opts.note) + '</span>' : '')
    + '</div>';

  const d = res.data || {};
  if (!res.ok) {
    const code = d.code != null ? String(d.code) : '';
    const hint = d.hint || hintFor(code);
    html += '<div class="alert err">'
      + '<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.01"/></svg>'
      + '<div><b>' + esc(d.error || 'Permintaan gagal') + (code ? ' · <code>' + esc(code) + '</code>' : '') + '</b>'
      + (hint ? esc(hint) : '') + '</div></div>';
  }
  html += '<pre>' + esc(JSON.stringify(d, null, 2)) + '</pre>';
  box.innerHTML = html;
}

function hintFor(code){
  switch (String(code)) {
    case 'CAPTCHA_REQUIRED': return 'Shopee minta captcha. Login manual sekali di browser, lalu salin captcha_signature dari request send_otp yang sukses.';
    case 'DEVICE_BLOCKED': return 'Device-check menolak. Isi SHOPEE_DEVICE_ID + SHOPEE_DEVICE_REPORT dari browser yang pernah login sukses.';
    case 'PASSWORD_REQUIRED': return 'Akun ini memakai password. Isi kolom password di langkah 1 lalu ulangi.';
    case 'RATE_LIMITED': return 'Terlalu sering minta OTP. Tunggu 10–30 menit sebelum mencoba lagi.';
    default: return '';
  }
}

/* ============================================================
   endpoint registry
   ============================================================ */
const EP = [
  /* ---- GoPay ---- */
  { g:'gopay', m:'POST', p:'/api/gopay/otp', t:'Request OTP GoMerch',
    d:'Kirim OTP ke nomor akun GoBiz. Balasan berisi otp_token yang dipakai di langkah verifikasi.',
    f:[{k:'phone', l:'Nomor HP', ph:'0812xxxxxxx', req:1}] },
  { g:'gopay', m:'POST', p:'/api/gopay/verify', t:'Verifikasi OTP GoMerch',
    d:'Tukar OTP + otp_token jadi access_token. Kalau "Simpan" = ya, token langsung dipakai dashboard.',
    f:[{k:'otp', l:'Kode OTP', ph:'123456', req:1},{k:'otp_token', l:'otp_token', ph:'dari langkah 1', req:1},
       {k:'save', l:'Simpan di server', type:'select', opts:[['1','Ya'],['0','Tidak']]}] },
  { g:'gopay', m:'GET', p:'/api/pay/history?provider=gopay', t:'Mutasi QRIS GoPay',
    d:'Riwayat transaksi QRIS 7 hari terakhir dari jurnal GoBiz.',
    f:[], q:{provider:'gopay'} },

  /* ---- Shopee ---- */
  { g:'shopee', m:'POST', p:'/api/shopee/diagnose', t:'Diagnosa alur OTP',
    d:'Menjalankan alur sampai SEBELUM send_otp: device-risk, password, setelan OTP. Aman dipanggil berulang tanpa memicu OTP atau rate limit.',
    f:[{k:'phone', l:'Nomor HP', ph:'0812xxxxxxx', req:1},{k:'password', l:'Password (opsional)', ph:'password akun', type:'password'}] },
  { g:'shopee', m:'POST', p:'/api/shopee/otp', t:'Kirim OTP ShopeePay',
    d:'Kirim OTP ke channel pilihan. Balasan berisi challenge terenkripsi + jejak langkah (trace) untuk audit.',
    f:[{k:'phone', l:'Nomor HP', ph:'0812xxxxxxx', req:1},{k:'password', l:'Password (opsional)', ph:'password akun', type:'password'},
       {k:'channel', l:'Channel', type:'select', opts:[['','Otomatis'],['1','1 SMS'],['2','2 Email'],['3','3 WhatsApp'],['5','5 Aplikasi']]},
       {k:'captcha_signature', l:'captcha_signature', ph:'opsional'}] },
  { g:'shopee', m:'POST', p:'/api/shopee/verify', t:'Verifikasi OTP ShopeePay',
    d:'Tukar challenge + OTP jadi token merchant. Kalau akun punya beberapa merchant, balasan berisi daftar untuk dipilih.',
    f:[{k:'challenge', l:'challenge', ph:'dari langkah kirim OTP', req:1},{k:'otp', l:'Kode OTP', ph:'123456', req:1},
       {k:'save', l:'Simpan di server', type:'select', opts:[['1','Ya'],['0','Tidak']]}] },
  { g:'shopee', m:'POST', p:'/api/shopee/select', t:'Pilih merchant',
    d:'Lanjutkan login untuk merchant tertentu tanpa OTP baru, memakai verification dari langkah sebelumnya.',
    f:[{k:'verification', l:'verification', ph:'dari verify', req:1},{k:'merchant_id', l:'merchant_id', ph:'1234567890', req:1}] },
  { g:'shopee', m:'POST', p:'/api/shopee/logout', t:'Hapus sesi Shopee',
    d:'Menghapus sesi OTP dan token ShopeePay dari server. Pakai kalau mau login ulang dari nol.',
    f:[] },
  { g:'shopee', m:'GET', p:'/api/pay/history?provider=shopee', t:'Mutasi QRIS ShopeePay',
    d:'Riwayat transaksi QRIS 7 hari terakhir dari Partner Portal.',
    f:[], q:{provider:'shopee'} },

  /* ---- Pembayaran ---- */
  { g:'pay', m:'POST', p:'/api/pay/create', t:'Buat QRIS dinamis',
    d:'Ubah QRIS statis jadi QRIS dinamis dengan nominal tertentu. Balasan berisi qr_string dan gambar PNG base64.',
    f:[{k:'provider', l:'Provider', type:'select', opts:[['gopay','GoPay'],['shopee','ShopeePay']], req:1},
       {k:'amount', l:'Nominal (Rp)', ph:'15000', req:1, type:'number'}] },
  { g:'pay', m:'POST', p:'/api/pay/check', t:'Cek status pembayaran',
    d:'Cocokkan nominal + waktu dibuat dengan mutasi. Satu struk hanya bisa diklaim satu pembeli.',
    f:[{k:'provider', l:'Provider', type:'select', opts:[['gopay','GoPay'],['shopee','ShopeePay']], req:1},
       {k:'amount', l:'Nominal (Rp)', ph:'15000', req:1, type:'number'},
       {k:'created_at', l:'created_at', ph:'ISO / epoch ms dari create', req:1}] },
  { g:'pay', m:'GET', p:'/api/token/status', t:'Status token semua provider',
    d:'Ringkasan token, sisa umur, jadwal refresh, dan error terakhir untuk kedua provider.',
    f:[] }
];

/* ============================================================
   render endpoint cards
   ============================================================ */
function fieldHtml(f){
  const req = f.req ? ' <span class="req">*</span>' : '';
  let input;
  if (f.type === 'select') {
    input = '<select data-f="' + f.k + '">' + f.opts.map(o =>
      '<option value="' + esc(o[0]) + '">' + esc(o[1]) + '</option>').join('') + '</select>';
  } else {
    input = '<input data-f="' + f.k + '" type="' + (f.type || 'text') + '" placeholder="' + esc(f.ph || '') + '"'
      + (f.type === 'number' ? ' inputmode="numeric"' : '') + '>';
  }
  return '<div class="field"><label>' + esc(f.l) + req + '</label>' + input + '</div>';
}

function cardHtml(e, i){
  const id = 'ep-' + e.g + '-' + i;
  const mcls = e.m === 'GET' ? 'get' : (e.m === 'DELETE' ? 'del' : 'post');
  return '<article class="card" id="' + id + '" data-search="' + esc((e.p + ' ' + e.t + ' ' + e.d).toLowerCase()) + '">'
    + '<button class="card-head" type="button" aria-expanded="false" aria-controls="' + id + '-b">'
    +   '<span class="method ' + mcls + '">' + e.m + '</span>'
    +   '<span class="card-title"><span class="p">' + esc(e.p) + '</span><span class="t">' + esc(e.t) + '</span></span>'
    +   '<svg class="chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>'
    + '</button>'
    + '<div class="card-body" id="' + id + '-b">'
    +   '<p class="card-desc">' + esc(e.d) + '</p>'
    +   (e.f.length ? '<div class="fields">' + e.f.map(fieldHtml).join('') + '</div>' : '')
    +   '<div class="actions">'
    +     '<button class="btn btn-primary" data-run>'
    +       '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m5 3 14 9-14 9V3Z"/></svg>'
    +       'Jalankan</button>'
    +     '<button class="btn btn-ghost btn-sm" data-copy>Salin cURL</button>'
    +   '</div>'
    +   '<div class="resp" data-resp></div>'
    + '</div></article>';
}

function mount(){
  ['gopay','shopee','pay'].forEach(g => {
    const list = $('#list-' + g);
    const items = EP.filter(e => e.g === g);
    list.innerHTML = items.map(cardHtml).join('');
    const c = $('[data-count="' + g + '"]');
    if (c) c.textContent = items.length + ' endpoint';
  });

  // accordion
  document.addEventListener('click', ev => {
    const head = ev.target.closest('.card-head');
    if (head) {
      const card = head.closest('.card');
      const open = card.classList.toggle('open');
      head.setAttribute('aria-expanded', open ? 'true' : 'false');
      return;
    }
    const run = ev.target.closest('[data-run]');
    if (run) { runCard(run.closest('.card')); return; }
    const cp = ev.target.closest('[data-copy]');
    if (cp) { copyCurl(cp.closest('.card')); return; }
  });
}

function cardEndpoint(card){
  const idx = Array.from(document.querySelectorAll('.card')).indexOf(card);
  return EP[idx];
}

function collect(card){
  const body = {};
  $$('[data-f]', card).forEach(inp => {
    const v = inp.value.trim();
    if (v !== '') body[inp.dataset.f] = v;
  });
  return body;
}

async function runCard(card){
  const e = cardEndpoint(card);
  const btn = $('[data-run]', card);
  const box = $('[data-resp]', card);
  const old = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<span class="spin"></span> Menjalankan…';
  const body = collect(card);
  let path = e.p, res;
  if (e.m === 'GET') {
    const qs = new URLSearchParams(e.q || {}).toString();
    res = await api(path + (qs ? (path.includes('?') ? '&' : '?') + qs : ''), undefined, 'GET');
  } else {
    res = await api(path, body, 'POST');
  }
  renderResp(box, res);
  btn.disabled = false;
  btn.innerHTML = old;
  if (res.ok) toast(e.t + ' berhasil');
  else toast(e.t + ' gagal', 'err');
}

function copyCurl(card){
  const e = cardEndpoint(card);
  const body = collect(card);
  const origin = location.origin;
  let cmd;
  if (e.m === 'GET') {
    const qs = new URLSearchParams(e.q || {}).toString();
    cmd = 'curl -s "' + origin + e.p + (qs ? (e.p.includes('?') ? '&' : '?') + qs : '') + '"';
  } else {
    cmd = "curl -s -X POST '" + origin + e.p + "' \\\n  -H 'Content-Type: application/json' \\\n  -d '" + JSON.stringify(body) + "'";
  }
  navigator.clipboard.writeText(cmd).then(
    () => toast('cURL disalin'),
    () => toast('Gagal menyalin', 'err')
  );
}

/* ============================================================
   search
   ============================================================ */
function initSearch(){
  const inp = $('#searchInput');
  inp.addEventListener('input', () => {
    const q = inp.value.trim().toLowerCase();
    let any = false;
    $$('.card').forEach(c => {
      const hit = !q || c.dataset.search.includes(q);
      c.classList.toggle('hidden', !hit);
      if (hit) any = true;
    });
    $$('.section').forEach(s => {
      const cards = $$('.card', s);
      if (!cards.length) return;
      const visible = cards.some(c => !c.classList.contains('hidden'));
      s.classList.toggle('hidden', !visible);
    });
    let empty = $('#searchEmpty');
    if (!any) {
      if (!empty) {
        empty = document.createElement('div');
        empty.id = 'searchEmpty';
        empty.className = 'empty';
        empty.innerHTML = '<b>Tidak ada endpoint cocok</b><br>Coba kata kunci lain, mis. “otp”, “mutasi”, “refresh”.';
        $('#sec-gopay').before(empty);
      }
      empty.classList.remove('hidden');
    } else if (empty) empty.classList.add('hidden');
  });
}

/* ============================================================
   OTP flow
   ============================================================ */
const flow = { challenge: null, verification: null, merchants: [] };

function setStep(n, state){
  const el = $('#st' + n);
  if (!el) return;
  el.classList.remove('locked', 'active', 'done');
  if (state) el.classList.add(state);
}
function unlock(n){ const el = $('#st' + n); if (el) el.classList.remove('locked'); }

function traceHtml(trace){
  if (!Array.isArray(trace) || !trace.length) return '';
  return '<div class="trace">' + trace.map(t => {
    const bad = t.error && t.error !== 0 && t.error !== 'unparsed';
    return '<span class="chip ' + (bad ? 'bad' : 'ok') + '"><span class="d"></span>' + esc(t.step) + '</span>';
  }).join('') + '</div>';
}

function stepsHtml(steps){
  if (!Array.isArray(steps) || !steps.length) return '';
  return '<div class="trace">' + steps.map(s =>
    '<span class="chip ' + (s.ok ? 'ok' : 'bad') + '"><span class="d"></span>' + esc(s.step) + '</span>'
  ).join('') + '</div>';
}

function busy(btn, on, label){
  if (on) {
    btn.dataset.old = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="spin"></span> ' + (label || 'Memproses…');
  } else {
    btn.disabled = false;
    btn.innerHTML = btn.dataset.old || btn.innerHTML;
  }
}

function initFlow(){
  const phone = $('#f-phone'), pass = $('#f-pass');

  /* --- step 1: diagnose --- */
  $('#btnDiag').addEventListener('click', async () => {
    const btn = $('#btnDiag');
    if (!phone.value.trim()) { toast('Isi nomor HP dulu', 'err'); phone.focus(); return; }
    busy(btn, true, 'Mendiagnosa…');
    const res = await api('/api/shopee/diagnose', { phone: phone.value.trim(), password: pass.value || undefined });
    busy(btn, false);
    const box = $('#diagResp');
    box.classList.add('show');
    const d = res.data || {};
    let html = '<div class="resp-bar"><span class="tag ' + (res.ok ? 's2' : 's4') + '">' + res.status + '</span><span>' + res.ms + ' ms</span></div>';
    if (res.ok) {
      const allOk = (d.steps || []).every(s => s.ok);
      html += '<div class="alert ' + (allOk ? 'ok' : 'warn') + '">'
        + '<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2 4 6v6c0 5 3.4 8.6 8 10 4.6-1.4 8-5 8-10V6Z"/></svg>'
        + '<div><b>' + esc(d.verdict || (allOk ? 'SIAP kirim OTP' : 'ADA HAMBATAN')) + '</b>'
        + 'device_id <code>' + esc(String(d.deviceId || '').slice(0, 12)) + '…</code> · risk token <code>' + esc(d.riskToken || '—') + '</code></div></div>';
      html += stepsHtml(d.steps);
      const failed = (d.steps || []).filter(s => !s.ok);
      if (failed.length) {
        html += '<div class="alert err"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16.5v.01"/></svg><div><b>Langkah gagal: ' + esc(failed.map(f => f.step).join(', ')) + '</b>'
          + esc(failed.map(f => f.detail && (f.detail.hint || f.detail.message)).filter(Boolean).join(' · ') || 'Lihat detail JSON di bawah.') + '</div></div>';
      }
      html += '<pre>' + esc(JSON.stringify(d, null, 2)) + '</pre>';
      box.innerHTML = html;
      if (allOk) { setStep(1, 'done'); unlock(2); setStep(2, 'active'); toast('Diagnosa lolos — lanjut kirim OTP'); }
      else { setStep(1, 'active'); toast('Ada hambatan, cek langkah yang merah', 'err'); }
    } else {
      renderResp(box, res);
      toast('Diagnosa gagal', 'err');
    }
  });

  $('#btnDiagHelp').addEventListener('click', () => {
    const box = $('#diagResp');
    box.classList.add('show');
    box.innerHTML = '<div class="alert warn">'
      + '<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 16v-4M12 8h.01"/></svg>'
      + '<div><b>Kenapa diagnosa dulu?</b>Diagnosa menjalankan alur sampai tepat sebelum <code>send_otp</code>. Jadi kalau OTP tidak sampai, kamu tahu apakah masalahnya di device-risk, password, atau captcha — tanpa memicu OTP baru dan tanpa kena rate limit.</div></div>';
  });

  /* --- step 2: send OTP --- */
  $('#btnOtp').addEventListener('click', async () => {
    const btn = $('#btnOtp');
    if (!phone.value.trim()) { toast('Isi nomor HP dulu', 'err'); return; }
    busy(btn, true, 'Mengirim OTP…');
    const body = { phone: phone.value.trim() };
    if (pass.value) body.password = pass.value;
    if ($('#f-channel').value) body.channel = Number($('#f-channel').value);
    if ($('#f-captcha').value.trim()) body.captcha_signature = $('#f-captcha').value.trim();
    const res = await api('/api/shopee/otp', body);
    busy(btn, false);
    const box = $('#otpResp');
    box.classList.add('show');
    const d = res.data || {};
    let html = '<div class="resp-bar"><span class="tag ' + (res.ok ? 's2' : 's4') + '">' + res.status + '</span><span>' + res.ms + ' ms</span></div>';
    if (res.ok) {
      flow.challenge = d.challenge;
      const chName = {1:'SMS',2:'Email',3:'WhatsApp',5:'Aplikasi'}[d.channel] || ('channel ' + d.channel);
      html += '<div class="alert ok"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m5 13 4 4L19 7"/></svg>'
        + '<div><b>OTP dikirim via ' + esc(chName) + '</b>'
        + (d.channels && d.channels.length ? 'Channel tersedia: ' + esc(d.channels.join(', ')) + '. ' : '')
        + 'Challenge berlaku 5 menit.</div></div>';
      html += traceHtml(d.trace);
      html += '<pre>' + esc(JSON.stringify({ success: d.success, channel: d.channel, channels: d.channels, trace: d.trace }, null, 2)) + '</pre>';
      box.innerHTML = html;
      setStep(2, 'done'); unlock(3); setStep(3, 'active');
      $('#f-otp').focus();
      toast('OTP terkirim, masukkan kodenya');
    } else {
      renderResp(box, res);
      const code = String(d.code || '');
      if (code === 'PASSWORD_REQUIRED') { setStep(1, 'active'); pass.focus(); }
      toast('OTP gagal dikirim', 'err');
    }
  });

  /* --- step 3: verify --- */
  $('#btnVerify').addEventListener('click', async () => {
    const btn = $('#btnVerify');
    const otp = $('#f-otp').value.trim();
    if (!flow.challenge) { toast('Kirim OTP dulu', 'err'); return; }
    if (!/^\d{4,10}$/.test(otp)) { toast('OTP harus 4–10 digit', 'err'); $('#f-otp').focus(); return; }
    busy(btn, true, 'Memverifikasi…');
    const res = await api('/api/shopee/verify', {
      challenge: flow.challenge, otp, save: $('#f-save').value === '1'
    });
    busy(btn, false);
    const box = $('#verifyResp');
    box.classList.add('show');
    const d = res.data || {};
    if (res.ok && d.select) {
      flow.verification = d.verification;
      flow.merchants = d.merchants || [];
      box.innerHTML = '<div class="alert warn"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 16v-4M12 8h.01"/></svg>'
        + '<div><b>Akun ini punya ' + flow.merchants.length + ' merchant</b>Pilih satu untuk melanjutkan — tidak perlu OTP baru.</div></div>';
      $('#merchantPick').innerHTML = '<div class="merchants">' + flow.merchants.map(m =>
        '<button class="merchant" data-mid="' + esc(m.id) + '"><span class="n">' + esc(m.name || '(tanpa nama)') + '</span><span class="i">' + esc(m.id) + '</span></button>'
      ).join('') + '</div>';
      $$('#merchantPick .merchant').forEach(b => b.addEventListener('click', () => pickMerchant(b.dataset.mid)));
      toast('Pilih merchant dulu');
      return;
    }
    if (res.ok) {
      showToken(d);
      setStep(3, 'done'); unlock(4); setStep(4, 'done');
      toast('Login ShopeePay berhasil');
    } else {
      renderResp(box, res);
      toast('Verifikasi gagal', 'err');
    }
  });

  async function pickMerchant(mid){
    const res = await api('/api/shopee/select', {
      verification: flow.verification, merchant_id: mid, save: $('#f-save').value === '1'
    });
    if (res.ok) {
      $('#merchantPick').innerHTML = '';
      showToken(res.data);
      setStep(3, 'done'); unlock(4); setStep(4, 'done');
      toast('Merchant dipilih, token siap');
    } else {
      renderResp($('#verifyResp'), res);
      toast('Gagal memilih merchant', 'err');
    }
  }

  function showToken(d){
    const tok = d.token || '';
    $('#tokenOut').innerHTML =
      '<div class="alert ok"><svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m5 13 4 4L19 7"/></svg>'
      + '<div><b>' + esc(d.merchant || 'Merchant') + '</b>'
      + (d.saved ? 'Token disimpan di server dan dipakai dashboard/bot.' : 'Token hanya ditampilkan — tidak disimpan di server.')
      + '</div></div>'
      + '<div class="tokenbox"><span class="k">token</span> ' + esc(tok) + '</div>'
      + '<div class="actions"><button class="btn btn-ghost btn-sm" id="copyTok">Salin token</button>'
      + '<button class="btn btn-ghost btn-sm" id="copySes">Salin session</button></div>';
    $('#copyTok').addEventListener('click', () => navigator.clipboard.writeText(tok).then(() => toast('Token disalin')));
    $('#copySes').addEventListener('click', () => navigator.clipboard.writeText(JSON.stringify(d.session || {})).then(() => toast('Session disalin')));
    refreshStatus();
  }
}

/* ============================================================
   status + auto refresh
   ============================================================ */
let statusCache = null;

async function refreshStatus(){
  const res = await api('/api/token/status', undefined, 'GET');
  if (!res.ok) return;
  statusCache = res.data;
  const g = res.data.gopay || {}, s = res.data.shopee || {};

  const setPill = (id, st) => {
    const el = $(id);
    if (!el) return;
    el.classList.remove('on', 'off');
    el.classList.add(st.hasToken ? 'on' : 'off');
    const lbl = el.querySelector('.lbl');
    if (lbl) lbl.textContent = (id === '#pillGopay' ? 'GoPay' : 'Shopee') + (st.hasToken ? ' · aktif' : ' · kosong');
  };
  setPill('#pillGopay', g);
  setPill('#pillShopee', s);

  const hs = (id, st) => {
    const el = $(id);
    if (!el) return;
    el.classList.remove('ok', 'bad');
    if (!st.hasToken) { el.textContent = 'belum login'; el.classList.add('bad'); return; }
    if (st.msLeft != null && st.msLeft <= 0) { el.textContent = 'kedaluwarsa'; el.classList.add('bad'); return; }
    el.textContent = st.msLeft != null ? 'sisa ' + fmtLeft(st.msLeft) : 'aktif';
    el.classList.add('ok');
  };
  hs('#hsGopay', g);
  hs('#hsShopee', s);

  const lb = $('#loopBadge');
  if (lb) lb.textContent = res.data.loop ? 'loop server aktif' : 'tick manual';

  $$('#autoGrid .stat-card').forEach(card => {
    const p = card.dataset.prov;
    const st = p === 'gopay' ? g : s;
    const set = (k, v, cls) => {
      const el = $('[data-k="' + k + '"]', card);
      if (!el) return;
      el.textContent = v;
      el.classList.remove('ok', 'bad', 'warn');
      if (cls) el.classList.add(cls);
    };
    set('token', st.hasToken ? 'ada' : 'kosong', st.hasToken ? 'ok' : 'bad');
    set('left', st.msLeft != null ? fmtLeft(st.msLeft) : '—', st.msLeft != null && st.msLeft < 600000 ? 'warn' : '');
    set('last', st.lastRefreshAt ? fmtAgo(st.ageMs) : 'belum pernah');
    const tg = $('[data-auto-toggle]', card);
    if (tg && st.auto) tg.checked = !!st.auto.enabled;
    const mi = $('[data-auto-min]', card);
    if (mi && st.auto && document.activeElement !== mi) mi.value = st.auto.minutes;
  });
}

function initAuto(){
  $$('#autoGrid .stat-card').forEach(card => {
    const p = card.dataset.prov;
    $('[data-save]', card).addEventListener('click', async () => {
      const enabled = $('[data-auto-toggle]', card).checked;
      const minutes = Number($('[data-auto-min]', card).value) || 60;
      const res = await api('/api/auto/config', { provider: p, enabled, minutes });
      if (res.ok) { toast('Pengaturan ' + p + ' disimpan'); refreshStatus(); }
      else toast('Gagal menyimpan', 'err');
    });
    $('[data-refresh]', card).addEventListener('click', async () => {
      const btn = $('[data-refresh]', card);
      busy(btn, true, 'Refresh…');
      const res = await api('/api/refresh', { provider: p });
      busy(btn, false);
      if (res.ok) toast('Token ' + p + ' diperbarui');
      else toast((res.data && res.data.error) || 'Refresh gagal', 'err');
      refreshStatus();
    });
  });

  // tick tiap 60 detik selama halaman terbuka (pengganti cron di Vercel)
  setInterval(() => { api('/api/auto/tick', {}).catch(() => {}); }, 60000);
  setInterval(refreshStatus, 30000);
}

/* ============================================================
   drawer / login / misc
   ============================================================ */
function initChrome(){
  const drawer = $('#drawer'), overlay = $('#overlay'), btn = $('#menuBtn');
  const open = () => { drawer.classList.add('show'); overlay.classList.add('show'); drawer.setAttribute('aria-hidden','false'); btn.setAttribute('aria-expanded','true'); };
  const close = () => { drawer.classList.remove('show'); overlay.classList.remove('show'); drawer.setAttribute('aria-hidden','true'); btn.setAttribute('aria-expanded','false'); };
  btn.addEventListener('click', open);
  $('#closeDrawer').addEventListener('click', close);
  overlay.addEventListener('click', close);
  document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
  $$('#drawer a[href^="#"]').forEach(a => a.addEventListener('click', close));

  $('#dRefreshAll').addEventListener('click', async e => {
    e.preventDefault(); close();
    const res = await api('/api/auto/tick', {});
    toast(res.ok ? 'Tick dijalankan' : 'Tick gagal', res.ok ? '' : 'err');
    refreshStatus();
  });
  $('#dLogout').addEventListener('click', async e => {
    e.preventDefault(); close();
    const res = await api('/api/shopee/logout', {});
    toast(res.ok ? 'Sesi Shopee dihapus' : 'Gagal', res.ok ? '' : 'err');
    refreshStatus();
  });
  $('#dHelpOtp').addEventListener('click', e => {
    e.preventDefault(); close();
    document.getElementById('otpFlow').scrollIntoView({ behavior: 'smooth', block: 'start' });
    $('#btnDiagHelp').click();
  });
  $('#dManualToken').addEventListener('click', e => {
    e.preventDefault(); close();
    const card = $$('.card').find(c => c.querySelector('.p') && c.querySelector('.p').textContent.includes('/api/shopee/otp'));
    if (card) { card.classList.add('open'); card.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
  });

  // login
  const doLogin = async () => {
    const pw = $('#loginPass').value;
    const res = await api('/api/admin/login', { password: pw });
    if (res.ok) {
      $('#loginModal').classList.remove('show');
      $('#loginPass').value = '';
      toast('Berhasil masuk');
      if (loginResolve) { const r = loginResolve; loginResolve = null; r(); }
      refreshStatus();
    } else toast((res.data && res.data.error) || 'Password salah', 'err');
  };
  $('#loginBtn').addEventListener('click', doLogin);
  $('#loginPass').addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });

  if (window.__BOOT.locked && !window.__BOOT.admin) showLogin();
}

/* ============================================================
   boot
   ============================================================ */
mount();
initSearch();
initFlow();
initAuto();
initChrome();
refreshStatus();
})();
</script>
